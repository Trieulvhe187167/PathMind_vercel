# ============================================
# PathMind — local configuration
# ============================================
# Reference list of environment variables. PathMind does NOT read a .env file:
# set these in the backend process environment (e.g. add `set NAME=value`
# lines to start.bat, or set them in the shell before running it).
# Backend/frontend ports live in data/user/settings/system.json.
# ============================================

# Time zone passed into both backend and frontend.
TZ=UTC

# ============================================
# Billing / subscription (backend reads these from its environment)
# ============================================
# true  = show unconfigured gateways + "simulate payment" button (for local demo only!)
BILLING_DEMO_MODE=false
# Shared secret for POST /api/billing/webhook (header X-Billing-Signature =
# hex HMAC-SHA256 of the raw body). Leave empty to disable the webhook.
BILLING_WEBHOOK_SECRET=
# USD → VND rate used for display and the amount charged by VNPAY
BILLING_USD_VND_RATE=25400

# ============================================
# VNPAY (QR, domestic ATM cards, Visa/Mastercard/JCB) — see CLAUDE.md "VNPAY"
# ============================================
# Sandbox credentials: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# sandbox (default) or production
VNPAY_ENV=sandbox
# Public site URL: return page = <url>/pricing ; IPN to register with VNPAY =
# <url>/api/billing/vnpay/ipn (must be HTTPS for VNPAY to call it)
PATHMIND_PUBLIC_URL=http://localhost:3782

# ============================================
# Sign-up & email verification
# ============================================
# New accounts get a 6-digit code by email. Without SMTP_HOST the code is only
# written to the backend log and accounts are NOT blocked (email stays
# "unverified"). With SMTP configured, users must verify before signing in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address (defaults to SMTP_USERNAME)
SMTP_FROM=
# starttls | ssl | none
SMTP_TLS=starttls
# Set to false to keep sending codes but never block sign-in.
EMAIL_VERIFICATION_REQUIRED=
EMAIL_CODE_TTL_MINUTES=30
EMAIL_CODE_MAX_ATTEMPTS=5
# Max self-registrations per client IP per hour (0 = unlimited)
REGISTER_MAX_PER_IP_PER_HOUR=5

# ============================================
# Appearance
# ============================================
# Theme for visitors who are not signed in and for new accounts that have not
# picked one yet: snow (shown as "Default") | light | dark | glass
PATHMIND_DEFAULT_THEME=snow

# ============================================
# Security
# ============================================
# Key used to encrypt API keys stored in data/user/settings/model_catalog.json.
# Any long random string. If unset, a key is generated at data/system/secrets.key
# (protects copies of the settings file, but not a copy of the whole data/ dir).
# Keep this value — changing or losing it makes stored API keys unreadable.
PATHMIND_SECRETS_KEY=
# Sign-in lockout: wrong passwords allowed per client+account before a lock
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Set to 1 only behind your own reverse proxy (then X-Forwarded-For is trusted)
PATHMIND_TRUST_PROXY=
